rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /contas/{contaId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.uid == "COLE_SEU_UID_AQUI";
    }
    match /{document=**} { allow read, write: if false; }
  }
}
